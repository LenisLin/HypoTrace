{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HypoTrace Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_id",
    "artifact_type",
    "path",
    "created_by",
    "derived_from",
    "checksum",
    "summary",
    "validation_status"
  ],
  "properties": {
    "artifact_id": {"type": "string", "pattern": "^A(00|0[1-9]|[1-9][0-9]+)$"},
    "artifact_type": {"type": "string", "minLength": 1},
    "path": {"type": "string", "minLength": 1},
    "created_by": {
      "type": "string",
      "pattern": "^E(0[1-9]|[1-9][0-9]+)\\.[1-9][0-9]*$"
    },
    "derived_from": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "checksum": {"type": ["string", "null"]},
    "summary": {"type": "string", "minLength": 1},
    "validation_status": {"type": "string", "minLength": 1},
    "validation_expectation": {"type": "string", "minLength": 1}
  }
}
