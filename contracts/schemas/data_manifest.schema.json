{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HypoTrace Data Manifest",
  "type": "object",
  "required": ["task_id", "data_access_class", "nas_locator", "checksums"],
  "properties": {
    "task_id": {"type": "string"},
    "data_access_class": {"type": "string"},
    "nas_locator": {"type": "object"},
    "checksums": {"type": "object"},
    "modality": {"type": "array", "items": {"type": "string"}},
    "organism": {"type": "string"},
    "tissue": {"type": "string"},
    "metadata_columns": {"type": "array", "items": {"type": "string"}},
    "required_metadata_columns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
