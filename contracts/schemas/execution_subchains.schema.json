{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HypoTrace Execution Subchain Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_subchain_id",
    "linked_scientific_unit_id",
    "steps",
    "result_extraction"
  ],
  "properties": {
    "execution_subchain_id": {
      "type": "string",
      "pattern": "^E(0[1-9]|[1-9][0-9]+)$"
    },
    "linked_scientific_unit_id": {
      "type": "string",
      "pattern": "^S(0[1-9]|[1-9][0-9]+)$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "inputs",
          "call",
          "parameters",
          "outputs",
          "source_ref"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^E(0[1-9]|[1-9][0-9]+)\\.[1-9][0-9]*$"
          },
          "inputs": {
            "type": "array",
            "items": {"$ref": "#/$defs/io_object"}
          },
          "call": {"type": "string", "minLength": 1},
          "parameters": {"type": "object"},
          "outputs": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/io_object"}
          },
          "source_ref": {
            "oneOf": [
              {"type": "null"},
              {"$ref": "#/$defs/source_ref"}
            ]
          }
        }
      }
    },
    "result_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observations"],
      "properties": {
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/observation"}
        }
      }
    }
  },
  "$defs": {
    "io_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "object_content", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "object_content": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "locator"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation", "support", "interpretation"],
      "properties": {
        "observation": {"type": "string", "minLength": 1},
        "support": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1}
      }
    }
  }
}
