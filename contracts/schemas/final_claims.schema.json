{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HypoTrace Final Claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "claim_text",
          "derived_from_scientific_units",
          "supporting_execution_subchains",
          "supporting_artifacts",
          "evidence_vector"
        ],
        "properties": {
          "claim_id": {"type": "string", "pattern": "^C(0[1-9]|[1-9][0-9]+)$"},
          "claim_text": {"type": "string", "minLength": 1},
          "derived_from_scientific_units": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^S(0[1-9]|[1-9][0-9]+)$"
            },
            "uniqueItems": true
          },
          "supporting_execution_subchains": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^E(0[1-9]|[1-9][0-9]+)$"
            },
            "uniqueItems": true
          },
          "supporting_artifacts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^A(00|0[1-9]|[1-9][0-9]+)$"
            },
            "uniqueItems": true
          },
          "evidence_vector": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number"}
          }
        }
      }
    }
  }
}
