{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HypoTrace Scientific Chain Record",
  "type": "object",
  "required": [
    "scientific_unit_id",
    "unit_type",
    "question_or_hypothesis",
    "evidence_need",
    "method_intent",
    "execution_subchain_ids",
    "result",
    "conclusion"
  ],
  "properties": {
    "scientific_unit_id": {"type": "string"},
    "unit_type": {"type": "string"},
    "parent_units": {"type": "array", "items": {"type": "string"}},
    "question_or_hypothesis": {"type": "string"},
    "evidence_need": {"type": "array"},
    "method_intent": {"type": "array"},
    "execution_subchain_ids": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "object"},
    "conclusion": {"type": "object"},
    "next_question": {"type": ["string", "null"]}
  }
}
