{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hypotrace.local/schemas/stomicsdb_dual_chain_job.schema.json",
  "title": "STOmicsDB dual-chain candidate job assignment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_route",
    "attempt_id",
    "job_attempt_id",
    "max_revision_rounds",
    "stds_id",
    "case_id",
    "candidate_id",
    "chain_id",
    "case_manifest_path",
    "source_manifest_path",
    "case_data_manifest_path",
    "extraction_staging_directory",
    "review_staging_directory",
    "final_chain_directory",
    "current_chain_state",
    "next_action",
    "committed_revision_rounds",
    "remaining_revision_rounds",
    "input_binding",
    "data_readiness",
    "readiness_errors"
  ],
  "properties": {
    "case_route": {"const": "public_database_stomicsdb"},
    "attempt_id": {"$ref": "#/$defs/attempt_id"},
    "job_attempt_id": {"$ref": "#/$defs/job_attempt_id"},
    "max_revision_rounds": {"const": 2},
    "stds_id": {"$ref": "#/$defs/stds_id"},
    "case_id": {"pattern": "^stomicsdb_STDS[0-9]{7}$", "type": "string"},
    "candidate_id": {"$ref": "#/$defs/candidate_id"},
    "chain_id": {"$ref": "#/$defs/chain_id"},
    "case_manifest_path": {"$ref": "#/$defs/absolute_path"},
    "source_manifest_path": {"$ref": "#/$defs/absolute_path"},
    "case_data_manifest_path": {"$ref": "#/$defs/absolute_path"},
    "extraction_staging_directory": {"$ref": "#/$defs/absolute_path"},
    "review_staging_directory": {"$ref": "#/$defs/absolute_path"},
    "final_chain_directory": {"$ref": "#/$defs/absolute_path"},
    "current_chain_state": {
      "type": "string",
      "enum": ["absent", "draft", "needs_revision", "comparison_ready", "specification_ready", "blocked"]
    },
    "next_action": {
      "type": "string",
      "enum": ["extract_initial", "review_draft", "revise_reviewed", "verify_and_close", "close_blocked", "close_round3_handoff", "close_failed"]
    },
    "committed_revision_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
    "remaining_revision_rounds": {"type": "integer", "minimum": 0, "maximum": 2},
    "input_binding": {"$ref": "#/$defs/input_binding"},
    "data_readiness": {
      "type": "string",
      "enum": ["DATA_READY", "BLOCKED_EXTERNAL"]
    },
    "readiness_errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "used_data_object_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"pattern": "^D[0-9]{2,}$", "type": "string"}
    },
    "used_auxiliary_resource_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"pattern": "^A[0-9]{2,}$", "type": "string"}
    },
    "unresolved_auxiliary_resource_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"pattern": "^A[0-9]{2,}$", "type": "string"}
    }
  },
  "$defs": {
    "safe_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "attempt_id": {
      "type": "string",
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "job_attempt_id": {
      "type": "string",
      "maxLength": 112,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "stds_id": {
      "type": "string",
      "pattern": "^STDS[0-9]{7}$"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^C[0-9]{2,}$"
    },
    "chain_id": {
      "type": "string",
      "pattern": "^chain_sha256_[0-9a-f]{16}$"
    },
    "absolute_path": {
      "type": "string",
      "pattern": "^/[^\\u0000]+$"
    },
    "relative_path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "manifest_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "input_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stds_id",
        "candidate_id",
        "case_manifest",
        "source_manifest",
        "case_data_manifest"
      ],
      "properties": {
        "stds_id": {"$ref": "#/$defs/stds_id"},
        "candidate_id": {"$ref": "#/$defs/candidate_id"},
        "case_manifest": {"$ref": "#/$defs/manifest_binding"},
        "source_manifest": {"$ref": "#/$defs/manifest_binding"},
        "case_data_manifest": {"$ref": "#/$defs/manifest_binding"}
      }
    }
  }
}
