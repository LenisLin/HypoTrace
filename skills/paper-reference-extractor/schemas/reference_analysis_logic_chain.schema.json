{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Publication-Derived Reference Analysis Logic Chain JSONL Record",
  "description": "One curator-facing intermediate data-analysis step extracted from a paper. Records are evaluator-only reference anchors, not agent-visible prompts and not unique ground truth workflows.",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "paper_title",
    "source_pdf",
    "paper_domain",
    "assay_types",
    "chain_id",
    "chain_title",
    "chain_question",
    "chain_question_short",
    "chain_order",
    "depends_on_chain_ids",
    "step_id",
    "step_order",
    "step_title",
    "step_question",
    "connects_from",
    "connects_to",
    "analysis_scope",
    "task_grain",
    "step_origin",
    "evidence_level",
    "gold_confidence",
    "data_input",
    "previous_finding",
    "decision_rationale",
    "method_or_analysis",
    "what_it_tests",
    "article_explicit_operations",
    "likely_default_processing",
    "observed_evidence",
    "analysis_result",
    "biological_interpretation",
    "logic_gain",
    "next_decision",
    "remaining_gap",
    "interpretation_boundary",
    "evidence_support",
    "review_flags",
    "article_context_after_analysis"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "paper_id": {"type": "string", "minLength": 1},
    "paper_title": {"type": "string", "minLength": 1},
    "source_pdf": {"type": "string"},
    "paper_domain": {"type": "string"},
    "assay_types": {"type": "array", "items": {"type": "string"}},
    "chain_id": {"type": "string", "minLength": 1},
    "chain_title": {"type": "string"},
    "chain_question": {"type": "string", "minLength": 1},
    "chain_question_short": {"type": "string"},
    "chain_order": {"type": "integer", "minimum": 1},
    "depends_on_chain_ids": {"type": "array", "items": {"type": "string"}},
    "step_id": {"type": "string", "minLength": 1},
    "step_order": {"type": "integer", "minimum": 1},
    "step_title": {"type": "string"},
    "step_question": {"type": "string", "minLength": 1},
    "connects_from": {"type": ["string", "null"]},
    "connects_to": {"type": ["string", "null"]},
    "analysis_scope": {"const": "agent_executable_data_analysis"},
    "task_grain": {"const": "intermediate"},
    "step_origin": {"enum": ["explicit_method", "explicit_result", "inferred_default", "mixed"]},
    "evidence_level": {
      "enum": [
        "preprocessing",
        "association",
        "enrichment",
        "spatial_mapping",
        "network_support",
        "candidate_prioritization",
        "context_validation"
      ]
    },
    "gold_confidence": {"enum": ["high", "medium", "low"]},
    "data_input": {"type": "array", "items": {"type": "string"}},
    "previous_finding": {"type": "string"},
    "decision_rationale": {"type": "string", "minLength": 1},
    "method_or_analysis": {"type": "string", "minLength": 1},
    "what_it_tests": {"type": "string"},
    "article_explicit_operations": {"type": "array", "items": {"type": "string"}},
    "likely_default_processing": {"type": "array", "items": {"type": "string"}},
    "observed_evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "analysis_result": {"type": "string", "minLength": 1},
    "biological_interpretation": {"type": "string"},
    "logic_gain": {"type": "string", "minLength": 1},
    "next_decision": {"type": "string", "minLength": 1},
    "remaining_gap": {"type": "string"},
    "interpretation_boundary": {"type": "string", "minLength": 1},
    "evidence_support": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "anchor_text", "evidence_summary"],
        "properties": {
          "source_type": {"type": "string"},
          "page": {"type": ["integer", "null"]},
          "section": {"type": ["string", "null"]},
          "figure_or_table": {"type": ["string", "null"]},
          "anchor_text": {"type": "string", "minLength": 1},
          "evidence_summary": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "review_flags": {"type": "array", "items": {"type": "string"}},
    "article_context_after_analysis": {
      "type": "array",
      "description": "Paper context after the computational analysis, such as wet-lab, animal, clinical, or therapeutic validation. These entries must not be treated as connected agent-executable main-chain steps.",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": true
}
